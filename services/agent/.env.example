# LLM Provider - choose "openai" or "anthropic"
LLM_PROVIDER=openai

# API Keys (only one is required based on LLM_PROVIDER)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-api03-...

# Model Configuration
# Note: gpt-3.5-turbo recommended for OpenAI (gpt-4o-mini exceeds the 12s endpoint timeout)
# For Anthropic: claude-haiku-4-5-20251001
DEFAULT_MODEL=gpt-3.5-turbo
FALLBACK_MODEL=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-3-small

# Database
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=tickets

# Server
PORT=8765
HOST=127.0.0.1
DEBUG=false

# Behavior
AUTO_TRIAGE_ENABLED=true
MAX_DECOMPOSE_SUBTASKS=7
SEARCH_RESULTS_LIMIT=10
MAX_REQUESTS_PER_MINUTE=20
